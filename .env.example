SHORT_TERM_MAX_TURNS=20
VERBOSE_HARDWARE=true

# LLM usado para gerar respostas de dialogo/pergunta.
# Defina LLM_ENABLED=false para usar apenas respostas template (sem LLM).
LLM_ENABLED=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_TIMEOUT=30
STT_PROVIDER=openai_realtime
OPENAI_STT_MODEL=gpt-live-transcribe
STT_TIMEOUT=12

ROBOT_API_HOST=0.0.0.0
ROBOT_API_PORT=8000
# Development only: enables POST /debug/events for simulated sensor events.
DEBUG_EVENTS_ENABLED=false

# Localização fixa do Bob. Necessária para clima e fuso no cérebro em nuvem.
ROBOT_LOCATION_NAME=
ROBOT_LATITUDE=
ROBOT_LONGITUDE=
ROBOT_TIMEZONE=America/Sao_Paulo
WEATHER_TIMEOUT=6

# Spotify Web API (Authorization Code OAuth). Keep all three only on backend.
# Playback control requires an eligible Spotify account and an active device.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_TIMEOUT=8
MUSIC_POLL_SECONDS=1

# Home Assistant local. Crie um token de longa duração no perfil do usuário.
# O token fica somente no cérebro; nunca coloque-o no app do tablet/ESP32.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT=4

# Supabase: guarda as habilidades que o Bob aprende sozinho (ver skills/).
# Crie um projeto grátis em supabase.com, rode sql/001_learned_skills.sql
# no SQL Editor dele, e cole a Project URL + a chave "service_role"
# (Project Settings -> API -- não a "anon", pois é o próprio backend
# escrevendo, nunca o tablet).
SUPABASE_URL=
SUPABASE_KEY=

# Local neural TTS (Piper, ONNX, no API cost). Requires a downloaded voice
# model at PIPER_VOICE_PATH (default data/voices/pt_BR-faber-medium.onnx).
# Falls back to the tablet's own flutter_tts when disabled or unavailable.
PIPER_ENABLED=false
# "Robot voice" tuning -- all optional, tune to taste:
# PIPER_PITCH_SHIFT_SEMITONES=5
# PIPER_NOISE_SCALE=0.35
# PIPER_NOISE_W_SCALE=0.35
# PIPER_LENGTH_SCALE=1.15
# PIPER_RING_MOD_HZ=45
# PIPER_RING_MOD_WET=0.22
# PIPER_BITCRUSH_LEVELS=0
